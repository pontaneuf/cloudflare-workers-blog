---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<p class="copyright">&copy; {today.getFullYear()} <strong>pontaneuf</strong>. All rights reserved.</p>
		<p class="footer-tagline">Music, Games, Anime & Gadgets ✨</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding: 2.5rem 1rem 3.5rem 1rem;
		text-align: center;
		background: rgba(255, 255, 255, 0.4);
		backdrop-filter: blur(8px);
		border-top: 1px solid rgba(255, 255, 255, 0.6);
	}

	.footer-container {
		max-width: 600px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.copyright {
		margin: 0;
		font-size: 0.9rem;
		color: #64748b;
	}

	.footer-tagline {
		margin: 0;
		font-size: 0.825rem;
		color: #94a3b8;
		font-weight: 500;
	}
</style>
